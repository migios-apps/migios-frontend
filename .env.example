# Copy this file to `.env` — `docker compose` reads it automatically.
# On Coolify these go in the resource's Environment Variables tab instead.
#
# Every VITE_* value is inlined into the JS bundle at BUILD time. Two consequences:
#   1. changing one needs a rebuild (`docker compose up --build`), not a restart;
#   2. all of them ship to the browser — VITE_APP_CLIENT_SECRET is a public OAuth
#      client credential, not a server-side secret. Treat it as such.

# REQUIRED — backend REST API base URL, no trailing slash
VITE_PUBLIC_API_URL_V1=https://api.example.com

# REQUIRED — OAuth client credentials issued by migios-be
VITE_APP_CLIENT_ID=1
VITE_APP_CLIENT_SECRET=change-me

# OPTIONAL — router basename when served under a sub-path (e.g. /app). Blank = root.
VITE_BASENAME=

# OPTIONAL — vite build mode: production | staging | development
BUILD_MODE=production

# OPTIONAL — port nginx listens on inside the container
APP_PORT=57370

# OPTIONAL — port published on the host (Coolify maps the domain itself and ignores this)
PORT=57370
