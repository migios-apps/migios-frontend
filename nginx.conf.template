# Rendered by the nginx entrypoint into /etc/nginx/conf.d/default.conf at container
# startup — the listen port comes from APP_PORT (see Dockerfile / docker-compose.yaml).
server {
  listen ${APP_PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/plain text/css text/xml application/javascript application/json image/svg+xml;

  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer-when-downgrade" always;

  # Long-cache hashed build assets.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Never cache the shell — it points at the current hashed bundle.
  # The security headers are repeated because add_header in a location replaces,
  # rather than extends, the ones inherited from the server block.
  location = /index.html {
    add_header Cache-Control "no-cache, must-revalidate";
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
  }

  # SPA: serve real files, fall back to the app shell for client-side routes.
  location / {
    try_files $uri $uri/ /index.html;
  }

  location /health {
    access_log off;
    return 200 "healthy\n";
    add_header Content-Type text/plain;
  }
}
